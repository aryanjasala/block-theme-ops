{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fffaf3",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#2b211b",
					"name": "Contrast"
				},
				{
					"slug": "accent",
					"color": "#b5451b",
					"name": "Accent"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			}
		},
		"typography": {
			"fontSize": "18px",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
